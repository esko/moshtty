{
  "name": "Crostini Ghostty Terminal",
  "short_name": "Ghostty",
  "description": "A Crostini terminal PWA powered by ghostty-web.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["tabbed"],
  "tab_strip": {
    "new_tab_button": {
      "url": "/"
    }
  },
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "background_color": "#101820",
  "theme_color": "#101820",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
